{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["es2022"],
    "strict": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["jest", "node"],
    // The sample in bin/ imports the package by name, as a consumer would;
    // resolve it to the sources during development.
    "paths": {
      "cdk-spa-api-gateway": ["./src/constructs"]
    }
  },
  "include": ["src", "test", "bin"]
}
